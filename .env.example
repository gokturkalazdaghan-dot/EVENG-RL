# ==================== AI GUARD — BACKEND ENV (sunucu tarafı) ====================
# Bu dosya SADECE backend süreciyle birlikte deploy edilir; mobil uygulama
# build'ine ASLA dahil edilmez ve repo'ya gerçek değerlerle commit edilmez.

# RevenueCat
REVENUECAT_SECRET_API_KEY=sk_YOUR_REVENUECAT_SECRET_KEY   # server-to-server REST API için
REVENUECAT_WEBHOOK_AUTH_HEADER=REPLACE_WITH_RANDOM_SHARED_SECRET  # webhook doğrulaması

# Apple / Google receipt validation (yalnızca gerekiyorsa; RevenueCat kullanılıyorsa
# çoğu durumda bu adım RevenueCat tarafından zaten yapılır)
APPLE_SHARED_SECRET=your-app-specific-shared-secret
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/secrets/google-play-service-account.json

# Redis (Even Girl / Even Boy haftalık puanlama ZSET'i)
REDIS_URL=redis://127.0.0.1:6379

# ---- Ödül teklif kodları (reward_automation) ----
# Ödül olarak PRO hakkı VERİTABANINA YAZILMAZ; mağazanın tek kullanımlık
# tanıtım kodu üretilir ve kullanıcı native kullanım kâğıdında kullanır.
APPLE_APP_ID=0000000000                      # App Store sayısal uygulama kimliği
APPSTORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPSTORE_KEY_ID=XXXXXXXXXX
APPSTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ANDROID_PACKAGE_NAME=com.evengirl.app
PLAY_ACCESS_TOKEN=                           # Play Developer API OAuth erişim jetonu

# ---- Moderasyon (core_gateway/moderation) ----
# Nöbetçi personel jetonlarını imzalayan sır. TANIMSIZ İSE moderasyon uçları
# 503 döner ve hiç çalışmaz — varsayılan bir sırla açık bırakılmaz.
MODERATION_STAFF_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
DATABASE_URL=postgres://user:password@host:5432/evengirl

NODE_ENV=production
