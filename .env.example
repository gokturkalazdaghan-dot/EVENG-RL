# EVENGIRL — ortam değişkenleri
#
# Bu dosya YALNIZCA ANAHTAR ADLARINI taşır. Gerçek değerleri `.env`e yazın;
# `.env` .gitignore'dadır ve asla commit edilmez.
#
#   cp .env.example .env
#
# TÜMÜ SUNUCU TARAFIDIR. Hiçbiri `VITE_` önekli değildir ve olmamalıdır:
# `VITE_` önekli her değer JS paketine gömülür ve tarayıcıdan okunabilir.
# Bu anahtarlar `createServerFn(...).handler()` içinde okunuyor
# (src/lib/imagine-api.ts, src/lib/oracle.ts) — TanStack Start o gövdeleri
# istemci paketinden çıkarır.

# ─── Görsel ve video üretimi (Oluştur sekmesi) ─────────────────────────
# Zincir: Flux → Nano Banana → fal → GPT Image → Imagine
# Video zinciri: HeyGen → Kling → Imagine Video
# HİÇBİRİ ZORUNLU DEĞİL. Boşsa üretim cihaz üstü yedeğe düşer
# (processSource "backdrop"); uygulama çalışmaya devam eder.

XAI_API_KEY=          # Grok Imagine — fal (Kahin) yorumu ve görsel yedeği
HEYGEN_API_KEY=       # Konuşan video (15 / 30 / 60 sn)
BFL_API_KEY=          # Flux 2 Pro
GEMINI_API_KEY=       # Nano Banana
FAL_KEY=              # fal.ai — Nano Banana / Flux / Seedream / Kling
OPENAI_API_KEY=       # GPT Image

# ─── Yayın (opsiyonel) ─────────────────────────────────────────────────
# og:image mutlak URL'i için genel ana makine. Boşsa istek Host'u kullanılır.
VITE_PUBLIC_HOSTNAME=

# ─── Oturum açma — BU ÜRÜNDE KAPALI ────────────────────────────────────
# CLAUDE.md: hesap yok, kalıcılık localStorage. Auth iskeleti duruyor ama
# kapalı; anahtarı `.grok/app-env.json` tutuyor (VITE_AUTH_ENABLED=false).
# DATABASE_URL'i doldurmak auth kapalıyken HATA verir (fail-closed):
# yarı yapılandırılmış bir kimlik katmanı sessizce çalışıyor sanılmasın diye.
# DATABASE_URL=
# BETTER_AUTH_SECRET=

# ─── Android / Banuba ──────────────────────────────────────────────────
# Banuba token'ı BURAYA KONMAZ. Yalnızca native tarafta durur:
#   yerel  → android/banuba.properties  (.gitignore)
#   CI     → ortam değişkeni BANUBA_TOKEN
# JS paketine (VITE_*) konursa WebView'den çıkarılabilir.
