{
  "name": "even-girl-app",
  "version": "1.0.0",
  "private": true,
  "description": "EVEN GIRL — kurumsal düzeyde AI video/fotoğraf düzenleme uygulaması (React Native + TypeScript)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "gen:obf": "node tools/gen-obfuscated-strings.mjs",
    "verify:security": "node tools/gen-obfuscated-strings.mjs --check && node tools/verify-security-config.mjs",
    "prebuild:release": "npm run verify && npm run verify:release",
    "bundle:android:release": "cd android && ./gradlew bundleRelease",
    "archive:ios:release": "cd ios && xcodebuild -workspace EvenGirl.xcworkspace -scheme EvenGirl -configuration Release archive",
    "verify": "npm run verify:security && npm run verify:privacy && npm run verify:i18n && npm run verify:store && npm run verify:native && npm run typecheck && npm test",
    "verify:i18n": "node tools/verify-i18n.mjs",
    "verify:privacy": "node tools/verify-privacy.mjs",
    "verify:release": "node ../tools/verify-release-ready.mjs",
    "verify:store": "node ../tools/verify-store-products.mjs",
    "verify:native": "node ../tools/verify-native-project.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11.4.1",
    "i18next": "^23.16.8",
    "react": "18.3.1",
    "react-i18next": "^15.1.3",
    "react-native": "0.76.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-mmkv": "^3.1.0",
    "react-native-purchases": "^8.2.3",
    "react-native-reanimated": "^3.16.1",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-screens": "^4.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "typescript": "^5.6.3"
  }
}
