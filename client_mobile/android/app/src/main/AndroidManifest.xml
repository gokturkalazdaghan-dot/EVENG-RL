<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      İZİN POLİTİKASI — "Sıfır kişisel veri toplama" ilkesi izin listesinde başlar.
      Talep EDİLMEYENLER (bilinçli): READ_CONTACTS, ACCESS_FINE_LOCATION,
      READ_PHONE_STATE, GET_ACCOUNTS, AD_ID. Bunların hiçbiri uygulamanın
      işlevi için gerekli değildir ve Play Data Safety formunu kirletir.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- MEDYA İZNİ YOKTUR — bilerek.
         Medya seçimi sistem Fotoğraf Seçicisi ile yapılır
         (MediaStore.ACTION_PICK_IMAGES, öncesinde ACTION_OPEN_DOCUMENT).
         Seçici ayrı bir süreçte çalışır ve yalnızca kullanıcının SEÇTİĞİ
         öğeye geçici okuma izni verir; uygulama medya deposuna hiç erişmez.

         READ_MEDIA_IMAGES / READ_MEDIA_VIDEO burada TANIMLI DEĞİLDİR:
         istemek, Play Console'da ayrıca gerekçelendirme formu doldurmayı ve
         kullanıcıya "tüm fotoğraflarına erişim" sorusu sormayı gerektirirdi
         — hiç kullanılmayan bir yetki için. Bkz. media/MediaPickerModule.kt.

         Bir bağımlılık bu izinleri manifest birleştirmesiyle geri
         getirebilir; bu yüzden açıkça kaldırılıyorlar. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Play Billing -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Reklam kimliği AÇIKÇA kaldırılır: uygulamada hiç reklam yok ve
         Play, bağımlılıklardan gelen AD_ID iznini otomatik ekleyebilir. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!--
      Android 11+ paket görünürlüğü: resolveActivity ve getPackageInfo,
      burada bildirilmeyen paketleri GÖREMEZ. Bildirmezsek "Instagram kurulu
      değil" sonucu her cihazda döner ve doğrudan paylaşım hiç çalışmaz.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <!-- Çapraz paylaşımda dosyaları content:// URI olarak sunar. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
