<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider yolları.

  Android 7'den beri başka uygulamaya `file://` URI verilemez
  (FileUriExposedException). Paylaşılan dosyalar bu yollardan `content://`
  URI olarak sunulur.

  Yalnızca paylaşıma açık dizinler listelenir: kullanıcının projeleri ve
  render çıktıları. Şifreli depo, model dosyaları ve önbelleğin geri kalanı
  BURADA YOKTUR — FileProvider'a geniş bir kök vermek, herhangi bir
  uygulamanın uygulama verisini okuyabilmesi demektir.
-->
<paths>
    <files-path name="exports" path="exports/" />
    <files-path name="projects" path="projects/" />
    <cache-path name="render" path="render/" />
</paths>
