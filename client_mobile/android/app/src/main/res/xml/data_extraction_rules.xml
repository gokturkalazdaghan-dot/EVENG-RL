<?xml version="1.0" encoding="utf-8"?>
<!--
  Yedekleme politikası (Android 12+).

  Hiçbir şey yedeklenmez ve cihazdan cihaza aktarılmaz:
  - Şifreli anahtar deposu (EncryptedSharedPreferences) Keystore anahtarına
    bağlıdır; başka cihazda çözülemez, yedeklemek anlamsız ve risklidir.
  - Render önbelleği zaten yeniden üretilebilir; yedeğe alınması kullanıcının
    Drive kotasını gereksiz doldurur.
  - Abonelik durumu mağazadan (StoreKit/Play Billing) geri yüklenir, yedekten
    değil — yedekten gelen "isPro" değeri sahtelenebilir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
