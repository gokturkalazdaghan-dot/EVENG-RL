<?xml version="1.0" encoding="UTF-8"?>
<!--
  EVEN GIRL — Info.plist (güvenlik ve gizlilikle ilgili anahtarlar).

  ATS: NSAllowsArbitraryLoads TANIMLI DEĞİLDİR (varsayılan = TLS zorunlu).
  Bir istisna eklenirse scripts/verify-release-hardening.sh build'i kırar.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>EVEN GIRL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Açılış ekranı ZORUNLU: olmadan uygulama iPhone'da küçük bir
         pencerede açılır ve App Store incelemesinde reddedilir. -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!-- Yalnızca dikey: editör jestleri (yatay=ekran, dikey=katman) yatay
         modda çakışır ve kullanıcı hangi yönün ne yaptığını öğrenemez. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>CFBundleIdentifier</key>
    <string>com.evengirl.app</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Jailbreak tespiti için canOpenURL kontrolü. iOS 9+ bu şemaların
         önceden bildirilmesini zorunlu kılar. -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>cydia</string>
        <string>sileo</string>
        <string>zbra</string>
        <!-- Çapraz paylaşım hedefleri. Bildirilmezse canOpenURL her zaman
             false döner ve doğrudan aktarım sessizce ölür. -->
        <string>instagram</string>
        <string>instagram-stories</string>
        <string>whatsapp</string>
    </array>

    <!-- Gizlilik açıklamaları: yalnızca gerçekten kullanılan iki izin.
         Kamera/mikrofon/konum/rehber İSTENMEZ. -->
    <!-- NSPhotoLibraryUsageDescription (TAM OKUMA) BİLİNÇLİ OLARAK YOKTUR.
         Medya seçimi PHPickerViewController ile yapılıyor; seçici ayrı bir
         süreçte çalışır ve yalnızca kullanıcının seçtiği öğenin kopyasını
         verir, kütüphaneye erişim İSTEMEZ. Bu anahtarı tanımlamak,
         kullanılmayan bir yetkiyi gizlilik etiketine ve App Store
         incelemesine sokmak olurdu. Bkz. Media/MediaPickerModule.swift.

         Aşağıdaki EKLEME izni ayrıdır ve okuma hakkı vermez: yalnızca
         kullanıcının düzenlediği çıktıyı galeriye yazmak için. -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Düzenlediğiniz içerikleri galerinize kaydetmek için kullanılır.</string>

    <!-- Reklam takibi İSTENMEZ: uygulamada reklam yoktur, IDFA hiç okunmaz.
         NSUserTrackingUsageDescription bilinçli olarak TANIMSIZDIR. -->

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>UIBackgroundModes</key>
    <array>
        <!-- Uzun render işlemlerinin arka planda tamamlanabilmesi için.
             Konum/ses gibi pil tüketen modlar TANIMLI DEĞİLDİR. -->
        <string>processing</string>
    </array>
</dict>
</plist>
